#!/bin/bash
set -euo pipefail

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=fixture-common
source "$root/fixture-common"

data=$(board_dir)
board="$data/overlord.json"
bak="$data/overlord.json.overlord-bak"
missing="$data/overlord.json.overlord-missing"

refuse_link "$data"
refuse_link "$board"
refuse_link "$bak"
refuse_link "$missing"

if [[ -f $bak ]]; then
  cp -a -- "$bak" "$board"
  rm -f -- "$bak"
elif [[ -f $missing ]]; then
  rm -f -- "$board" "$missing"
else
  echo "No fixture backup at $bak" >&2
  exit 1
fi

echo "Board restored."
if ! omarchy restart shell; then
  echo "Shell did not restart. Unlock the session and run: omarchy restart shell" >&2
  exit 1
fi
