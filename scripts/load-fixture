#!/bin/bash
set -euo pipefail

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=fixture-common
source "$root/fixture-common"

data=$(board_dir)
board="$data/overlord.json"
bak="$data/overlord.json.overlord-bak"
missing="$data/overlord.json.overlord-missing"

if [[ -f $bak || -f $missing ]]; then
  echo "A fixture backup is already in place. Run scripts/restore-board first." >&2
  exit 1
fi

refuse_link "$data"
mkdir -p "$data"
refuse_link "$data"
refuse_link "$board"
refuse_link "$bak"
refuse_link "$missing"

if [[ -f $board ]]; then
  cp -a -- "$board" "$bak"
else
  : > "$missing"
fi

refuse_link "$board"
BOARD="$board" node --input-type=module <<'JS'
import { constants, openSync, writeSync, closeSync } from "node:fs"

const board = process.env.BOARD
const now = Date.now()
const cards = [
  { id: "do-short", text: "Ship the note", urgent: true, important: true },
  { id: "do-long", text: "A long title that should elide instead of wrapping in the row", urgent: true, important: true },
  { id: "do-lines", text: "First line is the card\nSecond line stays in the editor", urgent: true, important: true }
]
for (let i = 1; i <= 12; i++) {
  cards.push({
    id: "sched-" + i,
    text: "scroll " + String(i).padStart(2, "0"),
    urgent: false,
    important: true
  })
}
cards.push(
  { id: "del-sam", text: "Ask Sam", urgent: true, important: false, delegatedAt: now - 60 * 1000 },
  { id: "del-riley", text: "Ask Riley", urgent: true, important: false, delegatedAt: now - 2 * 60 * 1000 },
  { id: "del-stale", text: "stale handoff", urgent: true, important: false, delegatedAt: now - 25 * 60 * 60 * 1000 },
  { id: "drop-bin", text: "bin me", urgent: false, important: false }
)
for (const card of cards) {
  card.createdAt = now
  card.updatedAt = now
  if (card.delegatedAt === undefined) card.delegatedAt = null
}
const body = JSON.stringify({
  version: 1,
  simple: false,
  confirmDelete: true,
  stats: { do: 4, schedule: 2, delegate: 3, eliminate: 1 },
  cards
}, null, 2) + "\n"
const fd = openSync(board, constants.O_WRONLY | constants.O_CREAT | constants.O_TRUNC | constants.O_NOFOLLOW)
writeSync(fd, body)
closeSync(fd)
JS

echo "Fixture written to $board"
echo "Walk tests/ui.md. Restore with scripts/restore-board."
if ! omarchy restart shell; then
  echo "Shell did not restart. Unlock the session and run: omarchy restart shell" >&2
  exit 1
fi
